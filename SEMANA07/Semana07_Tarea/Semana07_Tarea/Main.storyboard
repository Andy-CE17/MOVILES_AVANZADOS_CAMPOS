                                                    <rect key="frame" x="16" y="12" width="80" height="80"/>
                                                    <constraints>
                                                        <constraint firstAttribute="width" constant="80" id="cultura-image-width"/>
                                                        <constraint firstAttribute="height" constant="80" id="cultura-image-height"/>
                                                    </constraints>
                                                </imageView>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Nombre de la cultura" textAlignment="natural" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cultura-name">
                                                    <rect key="frame" x="112" y="30" width="192" height="22"/>
                                                    <fontDescription key="fontDescription" type="system" weight="semibold" pointSize="18"/>
                                                    <nil key="textColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Región" textAlignment="natural" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cultura-region">
                                                    <rect key="frame" x="112" y="58" width="192" height="19"/>
                                                    <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                                    <color key="textColor" systemColor="secondaryLabelColor"/>
                                                    <nil key="highlightedColor"/>
                                                </label>
                                            </subviews>
                                            <constraints>
                                                <constraint firstItem="cultura-image" firstAttribute="leading" secondItem="cultura-content" secondAttribute="leadingMargin" id="cultura-image-leading"/>
                                                <constraint firstItem="cultura-image" firstAttribute="centerY" secondItem="cultura-content" secondAttribute="centerY" id="cultura-image-center"/>
                                                <constraint firstItem="cultura-name" firstAttribute="leading" secondItem="cultura-image" secondAttribute="trailing" constant="16" id="cultura-name-leading"/>
                                                <constraint firstItem="cultura-name" firstAttribute="top" secondItem="cultura-content" secondAttribute="top" constant="30" id="cultura-name-top"/>
                                                <constraint firstAttribute="trailingMargin" secondItem="cultura-name" secondAttribute="trailing" id="cultura-name-trailing"/>
                                                <constraint firstItem="cultura-region" firstAttribute="leading" secondItem="cultura-name" secondAttribute="leading" id="cultura-region-leading"/>
                                                <constraint firstItem="cultura-region" firstAttribute="top" secondItem="cultura-name" secondAttribute="bottom" constant="4" id="cultura-region-top"/>
                                                <constraint firstAttribute="trailingMargin" secondItem="cultura-region" secondAttribute="trailing" id="cultura-region-trailing"/>
