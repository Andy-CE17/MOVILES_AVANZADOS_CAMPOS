                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Carrito" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-carrito-titulo">
