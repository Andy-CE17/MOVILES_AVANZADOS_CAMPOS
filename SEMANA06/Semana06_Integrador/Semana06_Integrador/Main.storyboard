                        <outlet property="igvLabel" destination="label-igv" id="outlet-igv"/>
                        <outlet property="subtotalLabel" destination="label-subtotal" id="outlet-subtotal"/>
                        <outlet property="totalLabel" destination="label-total" id="outlet-total"/>
                    </connections>
