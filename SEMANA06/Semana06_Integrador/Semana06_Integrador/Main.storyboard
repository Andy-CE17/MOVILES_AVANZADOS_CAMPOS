                            <constraint firstItem="stack-detalle" firstAttribute="top" secondItem="safe-detalle" secondAttribute="top" constant="70" id="detalle-top"/>
                            <constraint firstItem="safe-detalle" firstAttribute="trailing" secondItem="stack-detalle" secondAttribute="trailing" constant="32" id="detalle-trailing"/>
