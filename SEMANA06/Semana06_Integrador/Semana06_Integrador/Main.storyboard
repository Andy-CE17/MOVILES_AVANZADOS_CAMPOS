                                    </label>
                                    <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="stack-cantidad">
                                        <rect key="frame" x="0.0" y="134.66666666666669" width="329" height="48"/>
                                        <subviews>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-menos">
                                                <rect key="frame" x="0.0" y="0.0" width="101.66666666666667" height="48"/>
                                                <buttonConfiguration key="configuration" title="−"/>
                                                <connections>
                                                    <action selector="disminuirCantidad:" destination="vc-detalle" eventType="touchUpInside" id="action-menos"/>
                                                </connections>
                                            </button>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="1" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-cantidad">
                                                <rect key="frame" x="113.66666666666666" y="0.0" width="101.66666666666666" height="48"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="22"/>
                                            </label>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-mas">
                                                <rect key="frame" x="227.33333333333329" y="0.0" width="101.66666666666666" height="48"/>
                                                <buttonConfiguration key="configuration" title="+"/>
                                                <connections>
                                                    <action selector="aumentarCantidad:" destination="vc-detalle" eventType="touchUpInside" id="action-mas"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="height-cantidad"/>
                                        </constraints>
                                    </stackView>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-agregar">
                                        <rect key="frame" x="0.0" y="202.66666666666669" width="329" height="50"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="50" id="height-agregar"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" style="filled" title="Agregar al carrito"/>
                                        <connections>
                                            <action selector="agregarAlCarrito:" destination="vc-detalle" eventType="touchUpInside" id="action-agregar"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-detalle"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
