<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="25098" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="nav-001">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="25073"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--Navigation Controller-->
        <scene sceneID="scene-nav">
            <objects>
                <navigationController id="nav-001" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="nav-bar">
                        <rect key="frame" x="0.0" y="118" width="393" height="54"/>
                        <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                    </navigationBar>
                    <connections>
                        <segue destination="vc-formulario" kind="relationship" relationship="rootViewController" id="segue-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-nav" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-780" y="88"/>
        </scene>
        <!--View Controller-->
        <scene sceneID="scene-formulario">
            <objects>
                <viewController id="vc-formulario" customClass="ViewController" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-formulario">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="stack-formulario">
                                <rect key="frame" x="32" y="216.00000000000003" width="329" height="361.66666666666674"/>
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="DATOS DEL CLIENTE" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="titulo-formulario">
                                        <rect key="frame" x="0.0" y="0.0" width="329" height="28.666666666666668"/>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="24"/>
                                        <color key="textColor" systemColor="systemBlueColor"/>
                                    </label>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Por favor ingresa los siguientes datos:" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="subtitulo-formulario">
                                        <rect key="frame" x="0.0" y="40.666666666666686" width="329" height="18"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="15"/>
                                    </label>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Apellidos" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="etiqueta-apellido">
                                        <rect key="frame" x="0.0" y="70.666666666666686" width="329" height="20.333333333333329"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Ingresa tus apellidos" translatesAutoresizingMaskIntoConstraints="NO" id="input-apellido">
                                        <rect key="frame" x="0.0" y="103" width="329" height="38"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="38" id="alto-apellido"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                        <textInputTraits key="textInputTraits" autocapitalizationType="words"/>
                                    </textField>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Nombres" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="etiqueta-nombre">
                                        <rect key="frame" x="0.0" y="153" width="329" height="20.333333333333343"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Ingresa tus nombres" translatesAutoresizingMaskIntoConstraints="NO" id="input-nombre">
                                        <rect key="frame" x="0.0" y="185.33333333333331" width="329" height="38"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="38" id="alto-nombre"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                        <textInputTraits key="textInputTraits" autocapitalizationType="words"/>
                                    </textField>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="DNI" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="etiqueta-dni">
                                        <rect key="frame" x="0.0" y="235.33333333333331" width="329" height="20.333333333333343"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <textField opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" borderStyle="roundedRect" placeholder="Ingresa tu DNI" translatesAutoresizingMaskIntoConstraints="NO" id="input-dni">
                                        <rect key="frame" x="0.0" y="267.66666666666669" width="329" height="38"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="38" id="alto-dni"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                        <textInputTraits key="textInputTraits" keyboardType="numberPad"/>
                                    </textField>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-continuar">
                                        <rect key="frame" x="0.0" y="317.66666666666663" width="329" height="44"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="alto-continuar"/>
                                        </constraints>
                                        <state key="normal" title="Continuar"/>
                                        <connections>
                                            <action selector="btnContinuar:" destination="vc-formulario" eventType="touchUpInside" id="accion-continuar"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="safe-formulario"/>
                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                        <constraints>
                            <constraint firstItem="stack-formulario" firstAttribute="leading" secondItem="safe-formulario" secondAttribute="leading" constant="32" id="form-leading"/>
                            <constraint firstItem="stack-formulario" firstAttribute="top" secondItem="safe-formulario" secondAttribute="top" constant="44" id="form-top"/>
                            <constraint firstItem="safe-formulario" firstAttribute="trailing" secondItem="stack-formulario" secondAttribute="trailing" constant="32" id="form-trailing"/>
                        </constraints>
                    </view>
                    <navigationItem key="navigationItem" id="item-formulario"/>
                    <connections>
                        <outlet property="tfApellido" destination="input-apellido" id="outlet-input-apellido"/>
                        <outlet property="tfDni" destination="input-dni" id="outlet-input-dni"/>
                        <outlet property="tfNombre" destination="input-nombre" id="outlet-input-nombre"/>
                        <segue destination="vc-confirmacion" kind="show" identifier="mostrarConfirmacion" id="segue-confirmacion"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="first-formulario" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="0.0" y="88"/>
        </scene>
        <!--View Controller Confirmacion-->
        <scene sceneID="scene-confirmacion">
            <objects>
                <viewController storyboardIdentifier="ViewControllerConfirmacion" id="vc-confirmacion" customClass="ViewControllerConfirmacion" customModule="Semana06_02" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-confirmacion">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="18" translatesAutoresizingMaskIntoConstraints="NO" id="stack-confirmacion">
                                <rect key="frame" x="32" y="178" width="329" height="182"/>
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="DATOS INGRESADOS" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="titulo-confirmacion">
                                        <rect key="frame" x="0.0" y="0.0" width="329" height="28.666666666666668"/>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="24"/>
                                    </label>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Datos del cliente que fueron ingresados" textAlignment="center" lineBreakMode="tailTruncation" numberOfLines="0" translatesAutoresizingMaskIntoConstraints="NO" id="subtitulo-confirmacion">
                                        <rect key="frame" x="0.0" y="46.666666666666657" width="329" height="20.333333333333329"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="fila-apellido">
                                        <rect key="frame" x="0.0" y="85" width="329" height="20.333333333333329"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Apellidos:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-apellido">
                                                <rect key="frame" x="0.0" y="0.0" width="158.66666666666666" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="—" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-apellido">
                                                <rect key="frame" x="170.66666666666663" y="0.0" width="158.33333333333337" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="fila-nombre">
                                        <rect key="frame" x="0.0" y="123.3333333333333" width="329" height="20.333333333333329"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Nombres:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-nombre">
                                                <rect key="frame" x="0.0" y="0.0" width="158.66666666666666" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="—" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-nombre">
                                                <rect key="frame" x="170.66666666666663" y="0.0" width="158.33333333333337" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                    </stackView>
                                    <stackView opaque="NO" contentMode="scaleToFill" distribution="fillEqually" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="fila-dni">
                                        <rect key="frame" x="0.0" y="161.66666666666669" width="329" height="20.333333333333343"/>
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="DNI:" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-dni">
                                                <rect key="frame" x="0.0" y="0.0" width="158.66666666666666" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="—" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="value-dni">
                                                <rect key="frame" x="170.66666666666663" y="0.0" width="158.33333333333337" height="20.333333333333332"/>
                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                            </label>
                                        </subviews>
                                    </stackView>
                                </subviews>
                            </stackView>
                            <button opaque="NO" contentMode="scaleToFill" fixedFrame="YES" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cAQ-xA-TgQ">
                                <rect key="frame" x="160" y="500" width="72" height="35"/>
                                <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
                                <state key="normal" title="Button"/>
                                <buttonConfiguration key="configuration" style="plain" title="Volver"/>
                                <connections>
                                    <action selector="btnVolver:" destination="vc-confirmacion" eventType="touchUpInside" id="accion-volver"/>
                                </connections>
                            </button>
