        <scene sceneID="scene-boleta">
            <objects>
                <viewController id="vc-boleta" customClass="BoletaViewController" customModule="Semana06_Integrador" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-boleta">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="793"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
