                                        <rect key="frame" x="0.0" y="270" width="345" height="20.333333333333314"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="IGV (18%): S/ 0.00" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-igv">
