    </dependencies>
    <scenes>
        <scene sceneID="navigation-scene">
            <objects>
                <navigationController id="navigation-controller" sceneMemberID="viewController">
                    <navigationBar key="navigationBar" contentMode="scaleToFill" id="navigation-bar"/>
                    <connections>
                        <segue destination="view-controller" kind="relationship" relationship="rootViewController" id="root-segue"/>
                    </connections>
                </navigationController>
