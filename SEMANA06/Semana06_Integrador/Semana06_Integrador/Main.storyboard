                            <constraint firstItem="stack-catalogo" firstAttribute="top" secondItem="safe-catalogo" secondAttribute="top" constant="48" id="catalogo-top"/>
                            <constraint firstItem="safe-catalogo" firstAttribute="trailing" secondItem="stack-catalogo" secondAttribute="trailing" constant="28" id="catalogo-trailing"/>
