        <!--Carrito-->
        <scene sceneID="scene-carrito">
            <objects>
                <viewController id="vc-carrito" customClass="CarritoViewController" customModule="Semana06_Integrador" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="view-carrito">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
