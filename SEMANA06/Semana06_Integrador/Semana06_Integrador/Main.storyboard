                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Elige un producto" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="label-instruccion">
                                        <rect key="frame" x="0.0" y="47.666666666666686" width="337" height="20.333333333333329"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                    </label>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-refrigeradora">
                                        <rect key="frame" x="0.0" y="82" width="337" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="height-refri"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" style="filled" title="Refrigeradora · S/ 2000"/>
                                        <connections>
                                            <action selector="productoTapped:" destination="vc-catalogo" eventType="touchUpInside" id="action-refri"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" tag="1" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-licuadora">
                                        <rect key="frame" x="0.0" y="144" width="337" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="height-licuadora"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" style="filled" title="Licuadora · S/ 250"/>
                                        <connections>
                                            <action selector="productoTapped:" destination="vc-catalogo" eventType="touchUpInside" id="action-licuadora"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" tag="2" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-laptop">
                                        <rect key="frame" x="0.0" y="206" width="337" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="height-laptop"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" style="filled" title="Laptop · S/ 3500"/>
                                        <connections>
                                            <action selector="productoTapped:" destination="vc-catalogo" eventType="touchUpInside" id="action-laptop"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" tag="3" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-cocina">
                                        <rect key="frame" x="0.0" y="268" width="337" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="height-cocina"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" style="filled" title="Cocina · S/ 1200"/>
                                        <connections>
                                            <action selector="productoTapped:" destination="vc-catalogo" eventType="touchUpInside" id="action-cocina"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="button-carrito">
                                        <rect key="frame" x="0.0" y="330" width="337" height="44"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="height-carrito"/>
                                        </constraints>
                                        <buttonConfiguration key="configuration" title="Ver carrito (0)"/>
                                        <connections>
                                            <segue destination="vc-carrito" kind="show" identifier="verCarrito" id="segue-ver-carrito"/>
                                        </connections>
                                    </button>
                                </subviews>
                            </stackView>
