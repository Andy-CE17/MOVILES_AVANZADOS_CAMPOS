                            <constraint firstItem="stack-carrito" firstAttribute="top" secondItem="safe-carrito" secondAttribute="top" constant="24" id="carrito-top"/>
                            <constraint firstItem="safe-carrito" firstAttribute="trailing" secondItem="stack-carrito" secondAttribute="trailing" constant="24" id="carrito-trailing"/>
